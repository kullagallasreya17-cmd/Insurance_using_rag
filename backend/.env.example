GOOGLE_API_KEY=your-google-api-key
SECRET_KEY=replace-with-a-long-random-secret
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=insurance
MONGO_COLLECTION=document_vectors
ACCESS_TOKEN_EXPIRE_MINUTES=480
INDEXING_BACKEND=mongo
LOCAL_INDEXER_WORKERS=2
CACHE_BACKEND=mongo
CACHE_TTL_SECONDS=3600
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=documents
S3_BUCKET=
S3_PREFIX=insurance-documents
USE_HUGGINGFACE=1
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=your-huggingface-token
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token
